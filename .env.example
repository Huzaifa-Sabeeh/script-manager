APP_HOST=0.0.0.0
PORT=19000
HOST_HOME=/home/ubuntu
APP_UID=1001
APP_GID=1001
APP_ROOT=/opt/script-manager
SESSION_SECRET=replace-with-strong-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SCRIPT_ALLOWED_ROOT=/home/ubuntu
DOCKER_SOCKET_ENABLED=true
SCRIPTS_ROOT=/opt/script-manager/scripts
LOGS_ROOT=/opt/script-manager/logs
BACKUPS_ROOT=/opt/script-manager/backups
CREDENTIALS_ROOT=/opt/script-manager/credentials
MONGO_MODE=external
MONGODB_URI=mongodb://username:password@serverip:port/dbname?replicaSet=rs0&authSource=admin
# If `MONGO_MODE=local`, these values build MONGODB_URI automatically.
LOCAL_MONGO_HOST=mongodb
LOCAL_MONGO_PORT=27017
LOCAL_MONGO_DATABASE=script_manager_db
LOCAL_MONGO_USERNAME=script_manager
LOCAL_MONGO_PASSWORD=change-this-local-db-password
INITIAL_SCRIPTS=[{"name":"Git Pull Projects","path":"/home/ubuntu/bin/git-pull-projects.sh","description":"Pull origin/main for configured repositories"},{"name":"NPM Install Projects","path":"/home/ubuntu/npm-install-projects.sh","description":"Run npm install for selected projects"},{"name":"Docker Compose Deploy","path":"/home/ubuntu/docker-compose-deploy.sh","description":"Run docker compose up -d --build in deploy directories"}]
RUNS_MAX_PER_SCRIPT=200
RUN_RETENTION_DAYS=90
